{
  "expo": {
    "name": "kids-app",
    "slug": "kids-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "scheme": "kids-app",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#ffffff"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.kidsapp.printreact"
    },
    "plugins": [
      "expo-router",
      "./plugins/withNetworkSecurityConfig"
    ],
    "ios": {
      "bundleIdentifier": "com.kidsapp.printreact"
    }
  }
}
